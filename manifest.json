{
  "manifest_version": 3,
  "name": "Brightstar Bid bot",
  "description": "CSV batch resume & cover letters via ChatGPT — Brightstar Bid bot.",
  "version": "1.4.19",
  "permissions": ["storage", "downloads", "clipboardRead", "scripting", "tabs", "activeTab", "debugger", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/brightstar-icon.svg",
    "32": "icons/brightstar-icon.svg",
    "48": "icons/brightstar-icon.svg",
    "128": "icons/brightstar-icon.svg"
  },
  "action": {
    "default_title": "Brightstar Bid bot (Ctrl+Shift+Z)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/brightstar-icon.svg",
      "32": "icons/brightstar-icon.svg"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z",
        "mac": "Command+Shift+Z"
      },
      "description": "Open Brightstar Bid bot"
    },
    "autofill-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Autofill application form from active person"
    }
  }
}
