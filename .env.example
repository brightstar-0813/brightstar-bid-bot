# OpenAI (used for leftover application-form questions after profile + Q&A bank)
OPENAI_API_KEY=sk-your-key-here

# Optional — defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Custom Q&A Codex engine (Responses API, no browser tab).
# Uses OPENAI_API_KEY when CODEX_API_KEY is unset. Defaults to gpt-5.3-codex.
# CODEX_API_KEY=sk-your-key-here
# CODEX_MODEL=gpt-5.3-codex

# Resume + cover letter via API. Leave unset. ChatGPT/Claude tab stays the generator.
# OPENAI_DOCS=1
