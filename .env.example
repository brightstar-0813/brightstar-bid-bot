# OpenAI (used for leftover application-form questions after profile + Q&A bank)
OPENAI_API_KEY=sk-your-key-here

# Optional — defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Microsoft Graph (Greenhouse security-code emails from Outlook)
# 1. Azure Portal → App registrations → New registration
#    - Supported account types: Personal Microsoft accounts only (or multitenant + personal)
# 2. Authentication → Add platform → Single-page application (or Mobile/desktop)
#    Redirect URI: https://<your-extension-id>.chromiumapp.org/oauth2
#    (chrome.identity.getRedirectURL("oauth2") — see popup after load)
# 3. API permissions → Microsoft Graph delegated: Mail.Read, User.Read, offline_access
# 4. Paste Application (client) ID below
MS_GRAPH_CLIENT_ID=
